  "main": "index.js",
  "scripts": {
    "test": "concurrently \"npm run test --prefix server\" \"npm run test --prefix client\"",
    "test:e2e": "npm run test --prefix e2e",
    "e2e:serve": "cross-env NODE_ENV=test PORT=3003 node server/index.js",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "start": "cross-env NODE_ENV=production npm start --prefix server",
    "lint": "concurrently \"npm run lint --prefix server\" \"npm run lint --prefix client\""
  },
